#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x_id=0) in;
layout(std430,binding=0) readonly buffer Job {
    uint64_t midstate[25];
    uint64_t tail[17];
    uint target[8];
} job;
layout(std430,binding=1) buffer Result {
    uint winner;
    uint padding[3];
    uint digests[];
} result;
layout(push_constant) uniform Parameters {
    uint low;
    uint high;
    uint count;
    uint capture;
} params;
const uint64_t RC[24]=uint64_t[](
0x0000000000000001ul,0x0000000000008082ul,0x800000000000808aul,0x8000000080008000ul,
0x000000000000808bul,0x0000000080000001ul,0x8000000080008081ul,0x8000000000008009ul,
0x000000000000008aul,0x0000000000000088ul,0x0000000080008009ul,0x000000008000000aul,
0x000000008000808bul,0x800000000000008bul,0x8000000000008089ul,0x8000000000008003ul,
0x8000000000008002ul,0x8000000000000080ul,0x000000000000800aul,0x800000008000000aul,
0x8000000080008081ul,0x8000000000008080ul,0x0000000080000001ul,0x8000000080008008ul);
const uint RHO[25]=uint[](0,1,62,28,27,36,44,6,55,20,3,10,43,25,39,41,45,15,21,8,18,2,61,56,14);
uint64_t rol(uint64_t v,uint n){return n==0?v:(v<<n)|(v>>(64-n));}
uint swap32(uint v){return ((v&0xffu)<<24)|((v&0xff00u)<<8)|((v>>8)&0xff00u)|(v>>24);}
void keccak(inout uint64_t a[25]) {
    for(uint round=0;round<24;round++){
        uint64_t c[5],d[5],b[25];
        [[unroll]] for(uint x=0;x<5;x++)c[x]=a[x]^a[x+5]^a[x+10]^a[x+15]^a[x+20];
        [[unroll]] for(uint x=0;x<5;x++)d[x]=c[(x+4)%5]^rol(c[(x+1)%5],1);
        [[unroll]] for(uint y=0;y<5;y++){
            [[unroll]] for(uint x=0;x<5;x++){
                uint i=x+5*y;b[y+5*((2*x+3*y)%5)]=rol(a[i]^d[x],RHO[i]);
            }
        }
        [[unroll]] for(uint y=0;y<5;y++){
            [[unroll]] for(uint x=0;x<5;x++)a[x+5*y]=b[x+5*y]^((~b[(x+1)%5+5*y])&b[(x+2)%5+5*y]);
        }
        a[0]^=RC[round];
    }
}
void main(){
    uint index=gl_GlobalInvocationID.x;
    if(index>=params.count)return;
    uint64_t nonce=(uint64_t(params.high)<<32)|uint64_t(params.low);
    nonce+=uint64_t(index);
    uint64_t a[25];
    [[unroll]] for(uint i=0;i<25;i++)a[i]=job.midstate[i];
    [[unroll]] for(uint i=0;i<17;i++){
        uint64_t lane=job.tail[i];
        if(i==15)lane=(lane&0xfffffffful)|(uint64_t(swap32(uint(nonce>>32)))<<32);
        if(i==16)lane=(lane&0xffffffff00000000ul)|uint64_t(swap32(uint(nonce)));
        a[i]^=lane;
    }
    keccak(a);
    bool less=false,equal=true;
    [[unroll]] for(uint i=0;i<8;i++){
        uint word=swap32(uint(a[i/2]>>((i%2)*32)));
        if(params.capture!=0)result.digests[index*8+i]=word;
        if(equal&&word<job.target[i])less=true;
        if(word!=job.target[i])equal=false;
    }
    if(less||equal)atomicMin(result.winner,index);
}
