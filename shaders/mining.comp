#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x_id=0) in;
layout(std430,binding=0) readonly buffer Job {
    uint64_t midstate[25];
    uint64_t tail[17];
    uint target[8];
} job;
layout(std430,binding=1) buffer Result {
    uint winner;
    uint padding[3];
    uint digests[];
} result;
layout(std430,binding=2) readonly buffer Parameters {
    uint low;
    uint high;
    uint count;
    uint capture;
} params;
layout(push_constant) uniform Offset {uint base;uint size;} offset;
#include "keccak.glsl"
void main(){
    uint index=offset.base+gl_GlobalInvocationID.x;
    if(gl_GlobalInvocationID.x>=offset.size||index>=params.count)return;
    uint64_t nonce=(uint64_t(params.high)<<32)|uint64_t(params.low);
    nonce+=uint64_t(index);
    Lane a[25];
    [[unroll]] for(uint i=0;i<25;i++)a[i]=from64(job.midstate[i]);
    [[unroll]] for(uint i=0;i<17;i++){
        uint64_t lane=job.tail[i];
        if(i==15)lane=(lane&0xfffffffful)|(uint64_t(swap32(uint(nonce>>32)))<<32);
        if(i==16)lane=(lane&0xffffffff00000000ul)|uint64_t(swap32(uint(nonce)));
        a[i]^=from64(lane);
    }
    keccak(a);
    bool less=false,equal=true;
    [[unroll]] for(uint i=0;i<8;i++){
        uint word=swap32(word32(a[i/2],i%2));
        if(params.capture!=0)result.digests[index*8+i]=word;
        if(equal&&word<job.target[i])less=true;
        if(word!=job.target[i])equal=false;
    }
    if(less||equal)atomicMin(result.winner,index);
}
